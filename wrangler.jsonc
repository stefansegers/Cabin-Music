{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cabin-music",
	"account_id": "ab0e4510fa58c0dfd2343d59411b4483",
	"compatibility_date": "2026-06-03",
	"workers_dev": false,
	"routes": [{ "pattern": "teslaplex.stefansegers.nl", "custom_domain": true }],
	// Synced app state (pins), shared between the Mac and the car. Written only behind the passphrase.
	"kv_namespaces": [{ "binding": "CABIN_KV", "id": "0d57109da7264540943e23b210919ac3" }],
	// Pins are stored per Plex account; this account inherits the old shared pin list once.
	"vars": { "PINS_LEGACY_OWNER": "40356" },
	// Worker runs in front of the static assets: it proxies /plex (Plex JSON, with CORS headers)
	// and serves the SPA for everything else via the ASSETS binding.
	//
	// Optional private mode: `wrangler secret put CABIN_PASSPHRASE` gates /plex + /img behind a
	// passphrase (see README "Private mode"). Secrets are NOT stored here — never commit them.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	}
}
